{
  "name": "lepsi-rozvrh",
  "version": "2.0.0",
  "description": "Lepší Rozvrh – přehledné rozvrhy SPŠD z Bakalářů včetně změn, upozornění a PWA",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "node tools/build.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"backend/**\" --test-coverage-include=\"routes/**\" \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e-notifications": "node tools/e2e-notifications.js",
    "prefetch": "node scripts/run-prefetch.js",
    "process-notifications": "node scripts/process-notifications.js",
    "lesson-reminders": "node scripts/send-lesson-reminders.js",
    "cleanup": "node scripts/cleanup.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatcyk/hezci_rozvrhy.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hatcyk/hezci_rozvrhy/issues"
  },
  "homepage": "https://github.com/hatcyk/hezci_rozvrhy#readme",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": "22.x"
  }
}
