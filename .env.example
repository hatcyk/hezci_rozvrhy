# Bakaláři login credentials
# Account used by the prefetch job to log in to https://mot-spsd.bakalari.cz
BAKALARI_USERNAME='your_username_here'
BAKALARI_PASSWORD='your_password_here'

# Firebase Service Account
# Local: path to your Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH='./firebase-service-account.json'
# Vercel/CI: the entire service account JSON as a single string (use instead of the path)
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ...}'

# Debug mode - enables the /api/debug/* endpoints and extra logging.
# Keep this 'false' in production: the debug endpoints are unauthenticated and can
# send notifications and expose FCM tokens.
DEBUG=false

# Port the server listens on (default 3000)
# PORT=3000

# Cron Secret (protects /api/cron/* endpoints)
# Generate a random secret: openssl rand -base64 32
# Required in production — cron endpoints are refused if it is missing there.
CRON_SECRET='your_random_secret_here'

# Parallel page downloads from Bakaláři. Keep it at 3: more only loads the
# school's server (the GitHub workflow sets 3 too).
PREFETCH_CONCURRENCY=3

# Admin secret for /api/admin/* and the page /admin (Authorization: Bearer <ADMIN_SECRET>).
# Generate: openssl rand -base64 32 (min. 16 characters in production).
# Without it the admin API answers 503 everywhere (also locally).
# Left commented out on purpose: a copied placeholder would be a publicly known password.
# ADMIN_SECRET='paste_the_generated_secret_here'

# "Spustit sběr" on the admin page = GitHub workflow_dispatch of prefetch.yml.
# Fine-grained PAT, only this repository, permission "Actions: Read and write".
# GITHUB_DISPATCH_TOKEN='github_pat_...'
# GITHUB_REPO='hatcyk/hezci_rozvrhy'
# GITHUB_DISPATCH_REF=main                 # branch whose prefetch.yml runs (default main)
# GITHUB_DISPATCH_WORKFLOW=prefetch.yml    # default prefetch.yml

# Only behind your own reverse proxy (not Vercel): trust X-Forwarded-For for
# the admin rate limit / audit hash. Never enable without a proxy.
# TRUST_PROXY=1

# iCal export /api/ical/:type/:id.ics - public like the app. 'false' turns it off.
# ICAL_ENABLED=true
# Last day of the school half-year for the permanent timetable in iCal (RRULE UNTIL).
# Default: 31 January / 30 June depending on today's date.
# SEMESTER_END=2027-01-31

# Browser origins allowed to call the API (CORS), comma separated, no trailing slash.
# Default: https://spsd-rozvrhy.vercel.app,http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS='https://spsd-rozvrhy.vercel.app,http://localhost:3000'

# How a job run is labelled in the `runs` collection when not on GitHub
# (schedule | dispatch | manual | cron | http). deploy/crontab.example sets 'cron'.
# RUN_TRIGGER=cron

# Optional: lesson reminders
# LESSON_REMINDER_ENABLED=true         # 'false' turns reminders off entirely
# LESSON_REMINDER_MINUTES_BEFORE=5
# LESSON_REMINDER_WINDOW_START=6       # minutes before the lesson the window opens
# LESSON_REMINDER_WINDOW_END=1         # 0 = until the lesson starts
# LESSON_REMINDER_CONCURRENCY=10       # users processed in parallel
# REMINDER_HTTP_BUDGET_MS=25000        # /api/cron/lesson-reminders answers 202 after this (cron-job.org gives up at 30 s)
