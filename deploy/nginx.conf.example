# Lepší Rozvrh — reverse proxy.
#
# HTTPS is not optional here: service workers, push notifications and "add to
# home screen" only work in a secure context. http:// works on localhost during
# development and nowhere else.

server {
    listen 80;
    server_name rozvrh.example.cz;

    # Certbot's HTTP-01 challenge, if the host is reachable from the internet.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name rozvrh.example.cz;

    ssl_certificate     /etc/letsencrypt/live/rozvrh.example.cz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rozvrh.example.cz/privkey.pem;

    # The app sets its own caching: hashed bundles are immutable, the service
    # worker and index.html must always be revalidated. Do not add caching here.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    client_max_body_size 1m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
