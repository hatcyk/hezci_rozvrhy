rules_version = '2';

// Firestore Security Rules for Lepší Rozvrh — DRAFT, not deployed yet.
//
// The browser only READS. Everything is written by the server (Admin SDK,
// which bypasses these rules): prefetch, /api/fcm/*, /api/favorites/*, jobs.
// Without rules of our own, whatever the Firebase console was set to applies.
//
// Test with the emulator before deploying (see ZMENY.md / DEPLOYMENT.md):
//   firebase emulators:start --only firestore
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // The app signs every visitor in (anonymous anon-<uuid> custom token,
    // /api/auth), so "signed in" = "opened the app", not "a known person".
    function signedIn() {
      return request.auth != null;
    }

    // Public timetable data the app renders. `aggregates` = changes board and
    // free rooms (S3), written by prefetch.
    match /definitions/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /timetables/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /metadata/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /aggregates/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // A user's own settings document, by direct lookup only (no listing of
    // other users). Writes go through the API, which validates them.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Server-only operational records - the browser never reads them. Listed
    // explicitly (not just left to the catch-all) so the intent is visible:
    //   runs    - one document per job run (S4), read by /api/admin/*
    //   system  - health, migration flags, admin dispatch slot (S4, S5)
    //   audit   - admin access log with hashed IPs (S5)
    match /runs/{docId} {
      allow read, write: if false;
    }
    match /system/{docId} {
      allow read, write: if false;
    }
    match /audit/{docId} {
      allow read, write: if false;
    }

    // Also server-only: changes, lesson_notifications_sent. They fall through
    // to the deny-all rule below. (Overlapping matches are OR-ed, so this rule
    // cannot take away anything granted above.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
